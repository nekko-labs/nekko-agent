{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nekkoagent.com/schemas/package-1.json",
  "title": "Nekko Agent package manifest (nekko.json), format 1",
  "description": "The manifest at the root of a .nekko package: a plain zip carrying a customization, a mod or a custom layout. See spec/desktop/customizable-ui.md.",
  "type": "object",
  "required": ["format", "kind", "id", "name", "version"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": 1 },
    "kind": { "enum": ["customization", "mod", "layout"] },
    "id": { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$", "not": { "pattern": "^nekko\\." } },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "maxLength": 10000 },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string", "maxLength": 200 }, "url": { "type": "string", "maxLength": 500 } }
    },
    "license": { "type": "string", "maxLength": 100 },
    "engines": { "type": "object", "properties": { "nekko-agent": { "type": "string", "maxLength": 100 } } },
    "platforms": { "type": "array", "minItems": 1, "items": { "enum": ["desktop", "phone"] }, "default": ["desktop"] },
    "permissions": {
      "type": "array",
      "items": { "enum": ["chats:read", "chats:content", "chats:write", "hardware:read", "usage:read", "network", "files:read", "files:write", "tools:run"] },
      "default": []
    },
    "network": {
      "type": "object",
      "properties": { "hosts": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+(:\\d{1,5})?$" } } }
    },
    "contributes": {
      "type": "object",
      "properties": {
        "panels": { "type": "array", "items": { "$ref": "#/$defs/contribution" } },
        "monitors": { "type": "array", "items": { "$ref": "#/$defs/contribution" } },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/partId" },
              "label": { "type": "string", "minLength": 1, "maxLength": 200 },
              "shortcut": { "type": ["string", "null"], "maxLength": 40 }
            }
          }
        },
        "themes": { "type": "array", "items": { "type": "object" } },
        "settings": { "oneOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] }
      }
    },
    "main": { "oneOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] },
    "layout": { "oneOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] },
    "customization": { "type": ["object", "null"] }
  },
  "$defs": {
    "partId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" },
    "path": { "type": "string", "maxLength": 512, "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!(.*/)?\\.{1,2}(/|$))(?!.*//)[^/].*[^/]$|^[^/\\\\:.]$" },
    "contribution": {
      "type": "object",
      "required": ["id", "label", "slots", "entry"],
      "properties": {
        "id": { "$ref": "#/$defs/partId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "slots": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 64 } },
        "entry": { "$ref": "#/$defs/path" }
      }
    }
  }
}
