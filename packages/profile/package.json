{
  "name": "@nekko-agent/profile",
  "version": "0.9.8",
  "private": true,
  "type": "module",
  "description": "Node-side pieces the desktop app and the Local Web UI share: the user's data folder (where it lives, moving it, older installs' profiles), the running app, and the local server for HTML previews.",
  "exports": {
    "./user-data": {
      "types": "./dist/user-data.d.ts",
      "import": "./dist/user-data.js"
    },
    "./legacy-profiles": {
      "types": "./dist/legacy-profiles.d.ts",
      "import": "./dist/legacy-profiles.js"
    },
    "./app-control": {
      "types": "./dist/app-control.d.ts",
      "import": "./dist/app-control.js"
    },
    "./html-preview": {
      "types": "./dist/html-preview.d.ts",
      "import": "./dist/html-preview.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nekko-agent/shared": "*"
  }
}
