{
  "name": "@nekko-agent/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./user-data": {
      "types": "./dist/user-data.d.ts",
      "import": "./dist/user-data.js"
    },
    "./legacy-profiles": {
      "types": "./dist/legacy-profiles.d.ts",
      "import": "./dist/legacy-profiles.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nekko-agent/core": "*",
    "@nekko-agent/shared": "*",
    "@browserbasehq/stagehand": "4.2.0",
    "@lydell/node-pty": "^1.2.0-beta.15"
  }
}
