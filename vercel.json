{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --workspaces=false --include=dev --ignore-scripts --no-audit --no-fund",
  "buildCommand": "node scripts/build-docs.mjs",
  "ignoreCommand": "sh scripts/vercel-ignore.sh",
  "outputDirectory": "apps/website",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {"source":"/console", "headers":[{"key":"Content-Security-Policy","value":"frame-ancestors 'none'"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Cache-Control","value":"no-store"}]},
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|webp|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/brand/(.*)\\.zip",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"nekko-agent-brand-pack.zip\""
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(brand|press|press-kit|media-kit)",
      "destination": "/docs/brand",
      "permanent": false
    },
    {
      "source": "/docs/getting-started",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^(?:(?:www\\.)?agentnekko\\.com|www\\.nekkoagent\\.com|(?:www\\.)?kotrain\\.com|(?:www\\.)?kotrain\\.app|(?:www\\.)?nekkos\\.app|(?:www\\.)?nekkos\\.dev)$"
        }
      ],
      "destination": "https://nekkoagent.com/:path*",
      "permanent": true
    }
  ]
}
