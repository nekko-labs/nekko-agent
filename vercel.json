{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "apps/website",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|webp|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/docs/getting-started",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^(?:(?:www\\.)?agentnekko\\.com|www\\.nekkoagent\\.com|(?:www\\.)?kotrain\\.com|(?:www\\.)?kotrain\\.app|(?:www\\.)?nekkos\\.app|(?:www\\.)?nekkos\\.dev)$"
        }
      ],
      "destination": "https://nekkoagent.com/:path*",
      "permanent": true
    }
  ]
}
