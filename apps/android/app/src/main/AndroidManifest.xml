<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET only: the Google code scanner runs its own camera UI inside Play
         services, so this app never asks for the CAMERA permission. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Settings → Vibration: a short buzz when the agent needs you (install-time, no prompt). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".NekkoApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nekko"
        android:usesCleartextTraffic="false"
        tools:targetApi="36">

        <!-- Download the scanner module at install time instead of on first scan. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pairing QR opened from the system camera: nekko-agent-pair:?relay=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nekko-agent-pair" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nekko-agent" />
            </intent-filter>
            <!-- Share sheet: text or a link from another app pre-fills a new chat (never sent by itself). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- remoteMessaging: carries the conversation between the user's computer and this
             phone; no runtime permission and, unlike dataSync, no daily time limit. -->
        <service
            android:name=".connection.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />
    </application>
</manifest>
