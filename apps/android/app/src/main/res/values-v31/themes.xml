<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws a system splash on open. By default it shows the launcher icon
         on its own tile; show the borderless white mark on the brand plum instead, the
         iPhone's launch screen and the desktop splash (spec/brand/colour-palette.md).
         No windowSplashScreenIconBackgroundColor, so nothing is drawn behind the cat. -->
    <style name="Theme.Nekko" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
    </style>
</resources>
