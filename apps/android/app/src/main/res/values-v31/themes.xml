<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws a system splash on open. By default it shows the launcher icon on
         its own tile; show the plain brand plum instead, as the iPhone's launch screen does
         (#1894): the app's opening (lock/Splash.kt, #2120) builds the white cat in its first
         frame, which a finished cat on the splash would hide (spec/brand/colour-palette.md). -->
    <style name="Theme.Nekko" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
