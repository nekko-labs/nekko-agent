<?xml version="1.0" encoding="utf-8"?>
<!-- Release: TLS only. Relays are wss://; frames are E2E-sealed on top. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
