<?xml version="1.0" encoding="utf-8"?>
<!-- Plain ws:// is permitted app-wide, as on the iPhone, because a computer's
     own relay is usually reached at a LAN or tailnet IP (192.168.x.x,
     100.x.y.z) and this file can only name domains, not IP ranges.
     The barrier is in the app instead: RelayRoute.publicCleartext refuses
     ws:// (and the http:// health probe) to the open internet before
     dialing (OkHttpTransport, HealthProber), and RelayHint says why.
     Every frame is end-to-end encrypted on every path.
     Debug and release share this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
