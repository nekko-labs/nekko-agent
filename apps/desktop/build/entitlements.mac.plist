<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Hardened-runtime entitlements for the Developer ID build.

    The hardened runtime is mandatory for notarization, and it switches off
    several things Electron and Nekko Agent genuinely need. Each exception below is
    here for a reason; check the note before pruning one.

    This file is the main executable's (`entitlements`). The Electron helpers
    (which are the ones that actually run V8), nekkod and the rest of
    Resources/bin are signed with entitlements.mac.inherit.plist: the same
    keys without the three restricted ones at the bottom. Change one, change
    both.
  -->

  <!-- V8 compiles JavaScript at runtime. Without these the renderer helper
       crashes on launch under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Originally for @lydell/node-pty's prebuilt .node, which is gone:
       terminals run in nekkod (Rust) and electron-builder.yml has no
       asarUnpack any more. Kept until someone confirms on a notarized build
       that nothing the app or the inheriting nekkod loads still needs it
       (a follow-up, not a change to make blind). -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Nekko Agent spawns the user's shell, coding agents, and MCP servers as child
       processes, and has to be able to hand them an environment. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>

  <!-- Reading and writing the user's chosen project folders. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>

  <!-- Outbound: model providers, Ollama/LM Studio/vLLM, the update feed.
       Inbound: the local host server the phone relay pairs against. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- QrScanner.tsx calls getUserMedia to pair a phone by QR code. Pairs with
       NSCameraUsageDescription in the mac.extendInfo block. -->
  <key>com.apple.security.device.camera</key>
  <true/>

  <!-- Desktops (macOS Spaces): main/spaces.ts switches desktops by sending
       Mission Control's shortcuts to System Events through osascript. Apple
       events are blocked under the hardened runtime without this; pairs with
       NSAppleEventsUsageDescription in mac.extendInfo. Accessibility is asked
       for separately, only when the user picks "Allow and switch". -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>

  <!-- Settings → Security's "Add passkey on this computer": Electron's Touch ID
       authenticator keeps the WebAuthn credential in this keychain group,
       and macOS grants the group only when the signature carries it.

       All three keys are restricted: macOS refuses to launch a Developer ID
       app carrying them unless Contents/embedded.provisionprofile authorizes
       them (0.10.1000 shipped without one and did not open, #2688). The
       profile is mac.provisioningProfile in electron-builder.yml; a signed
       build without it fails (scripts/sign-mac.cjs). Only the main executable
       has the profile, so these never go in the inherit file: AMFI would kill
       every helper and nekkod.

       The team id is spelled out because codesign expands no build variable
       ($(AppIdentifierPrefix) is Xcode's). The group matches
       WEBAUTHN_KEYCHAIN_ACCESS_GROUP in src/main/webauthnPlatform.ts and the
       application identifier is the team id plus appId; tests hold both. An
       unsigned build is ad-hoc signed with no entitlements (after-pack.cjs),
       so Touch ID is unavailable there. -->
  <key>com.apple.application-identifier</key>
  <string>3HM5598S99.dev.nekkolabs.nekkoagent</string>
  <key>com.apple.developer.team-identifier</key>
  <string>3HM5598S99</string>
  <key>keychain-access-groups</key>
  <array>
    <string>3HM5598S99.dev.nekkolabs.nekkoagent.webauthn</string>
  </array>
</dict>
</plist>
