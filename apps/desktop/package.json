{
  "name": "@nekko-agent/desktop",
  "version": "0.8.1",
  "private": true,
  "description": "Nekko Agent desktop app.",
  "author": {
    "name": "Nekko Labs",
    "email": "support@nekkoagent.com"
  },
  "homepage": "https://github.com/nekko-labs/nekko-agent",
  "desktopName": "Nekko Agent",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/ensure-electron.mjs && npm run build:native-browser -- --dev",
    "dev": "node scripts/dev-launch.mjs dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:node && vitest run",
    "test:node": "node --test scripts/check-sandbox-syntax.node-test.cjs scripts/lifecycle-renderer-source.node-test.cjs scripts/notification-integration-safety.node-test.cjs scripts/notification-native-ci.node-test.cjs scripts/notification-native-ci-setup.node-test.cjs scripts/notification-native-local.node-test.cjs scripts/sign-mac.node-test.cjs",
    "test:subagents": "node scripts/subagent-integration.cjs",
    "test:wall-controls": "node scripts/wall-controls-integration.cjs",
    "test:grid-bugs": "node scripts/wall-controls-integration.cjs --grid-bugs",
    "test:repo-actions": "node scripts/agent-sidebar-integration.cjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:command-center": "node scripts/command-center-integration.cjs",
    "prestart": "node scripts/ensure-electron.mjs && npm run build:native-browser -- --dev",
    "start": "node scripts/dev-launch.mjs preview",
    "dist": "npm run build:app --prefix ../cli && electron-vite build && node scripts/stage-daemon.mjs && npm run build:native-browser && electron-builder",
    "release": "npm run build:app --prefix ../cli && electron-vite build && node scripts/stage-daemon.mjs && npm run build:native-browser && electron-builder --publish always",
    "build:native-browser": "node ../../scripts/build-agent-browser.mjs",
    "test:browser": "node ../../scripts/build-agent-browser.mjs --dev && node --test ../../scripts/agent-browser-native.test.mjs && node scripts/browser-automation-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@nekko-agent/profile": "*",
    "@nekko-agent/shared": "*",
    "@remotion/player": "4.0.535",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ghostty-web": "^0.4.0",
    "mermaid": "^12.1.0",
    "playwright-core": "1.63.0",
    "qrcode": "^1.5.4",
    "remotion": "4.0.535",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "app-builder-lib": "26.17.0",
    "electron": "45.0.0",
    "electron-builder": "26.17.0",
    "electron-updater": "^6.8.10",
    "electron-vite": "^6.0.0",
    "jimp": "^1.6.1",
    "jsqr": "^1.4.0",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resedit": "^3.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "zustand": "^5.0.15"
  }
}
