{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    // Type-check against @nekko-agent/shared's source in this tree, not a built dist
    // that may be stale or, in a worktree, the primary checkout's (#1153).
    "customConditions": ["source"]
  },
  "include": ["src/**/*"]
}
