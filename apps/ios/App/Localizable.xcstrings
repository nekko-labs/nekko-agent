    "Read only. Accept or revert changes on your computer. Touch and hold a change to ask the agent about it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur lesbar. Übernimm oder verwirf Änderungen auf deinem Computer. Halte eine Änderung gedrückt, um den Agent dazu zu fragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura. Acepta o revierte los cambios en tu computadora. Mantén presionado un cambio para preguntar al agente sobre él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture seule. Acceptez ou annulez les modifications sur votre ordinateur. Maintenez une modification pour interroger l’agent à son sujet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用です。変更の承認や取り消しはコンピュータで行ってください。変更を長押しすると、エージェントに質問できます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente leitura. Aceite ou reverta alterações no seu computador. Toque e segure uma alteração para perguntar ao agente sobre ela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读。请在电脑上接受或还原更改。长按某项更改可向智能体询问。"
          }
        }
      }
    },
