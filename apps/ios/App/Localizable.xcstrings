            "value": "Melde einen Fehler oder schlage eine Idee öffentlich vor und verfolge, was daraus wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa de un error o sugiere una idea en público, y sigue lo que pasa con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signalez un bug ou proposez une idée en public, et suivez ce qu’il en advient."
