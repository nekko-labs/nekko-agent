    "Paste it into Claude Code, Codex or Nekko Agent on your computer. It asks what happened, checks for an existing issue, and files one only after you approve it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge es in Claude Code, Codex oder Nekko Agent auf deinem Computer ein. Der Agent fragt, was passiert ist, sucht nach einem bestehenden Issue und legt erst eines an, wenn du zustimmst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pégalo en Claude Code, Codex o Nekko Agent en tu ordenador. Te pregunta qué pasó, busca si ya hay una incidencia y solo la crea cuando la apruebas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez-le dans Claude Code, Codex ou Nekko Agent sur votre ordinateur. Il demande ce qui s’est passé, cherche un ticket existant et n’en crée un qu’après votre accord."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータの Claude Code、Codex、Nekko Agent に貼り付けてください。何が起きたかを尋ね、既存の Issue を確認し、あなたが承認してから Issue を作成します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole no Claude Code, Codex ou Nekko Agent no seu computador. Ele pergunta o que aconteceu, procura uma issue existente e só cria uma depois que você aprovar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴到你电脑上的 Claude Code、Codex 或 Nekko Agent 中。它会询问发生了什么，查找已有的 issue，并且只在你同意后才创建。"
          }
        }
      }
    },
