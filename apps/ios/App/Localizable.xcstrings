      }
    },
    "The 55-character key you saved when sync was turned on, or the QR code in your recovery kit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der 55-stellige Schlüssel, den du beim Einschalten von Sync gesichert hast, oder der QR-Code in deinem Wiederherstellungs-Kit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La llave de 55 caracteres que guardaste al activar la sincronización, o el código QR de tu kit de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
