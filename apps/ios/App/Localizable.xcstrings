    "%lld files that may hold secrets aren’t shown on phones.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Dateien, die Geheimnisse enthalten könnten, werden auf Telefonen nicht angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld archivos que podrían contener secretos no se muestran en teléfonos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichiers pouvant contenir des secrets ne sont pas affichés sur les téléphones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機密情報を含む可能性のある%lld個のファイルは、iPhone では表示されません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld arquivos que podem conter segredos não são mostrados em celulares."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 个可能含有密钥的文件不会在手机上显示。"
          }
        }
      }
    },
