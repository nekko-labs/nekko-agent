    "Stage the files to commit first. Write message asks your computer’s model, which uses its tokens.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage zuerst die Dateien für den Commit. „Nachricht schreiben“ fragt das Modell deines Computers und verbraucht dessen Tokens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara primero los archivos para el commit. Escribir mensaje consulta el modelo de tu computadora, que usa sus tokens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indexez d’abord les fichiers à commiter. Rédiger le message interroge le modèle de votre ordinateur, qui consomme ses tokens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にコミットするファイルをステージしてください。メッセージを作成 はコンピュータのモデルに依頼し、そのトークンを消費します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare primeiro os arquivos do commit. Escrever mensagem consulta o modelo do seu computador, que usa os tokens dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先暂存要提交的文件。“撰写信息”会询问你电脑的模型，并消耗其 token。"
          }
        }
      }
    },
