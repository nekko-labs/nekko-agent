          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有什么可以变得更简单?"
          }
        }
      }
    },
    "What could use a fresh pair of eyes?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was braucht einen frischen Blick?"
          }
        },
        "es": {
