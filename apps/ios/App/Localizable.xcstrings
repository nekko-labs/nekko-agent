    "Running chats show on the Lock Screen and in the Dynamic Island, with Allow / Deny for approvals.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufende Chats erscheinen auf dem Sperrbildschirm und in der Dynamic Island, mit Erlauben / Verweigern für Freigaben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los chats en ejecución se muestran en la pantalla de bloqueo y en la Dynamic Island, con Permitir / Denegar para las aprobaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les discussions en cours s’affichent sur l’écran verrouillé et dans la Dynamic Island, avec Autoriser / Refuser pour les approbations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のチャットはロック画面とダイナミックアイランドに表示され、承認では許可 / 拒否を選べます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os chats em andamento aparecem na Tela de Bloqueio e na Dynamic Island, com Permitir / Negar para aprovações."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行中的聊天会显示在锁定屏幕和灵动岛上，批准请求可直接选择“允许”或“拒绝”。"
          }
        }
      }
    },
    "Runs its own relay: %@": {
      "localizations": {
