    "Pushed notifications say only what happened, never what your chats say. With the app lock on, the ones the app shows say less too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-Mitteilungen sagen nur, was passiert ist, nie, was in deinen Chats steht. Bei aktiver App-Sperre verraten auch die von der App angezeigten weniger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones push solo dicen qué ocurrió, nunca lo que dicen tus chats. Con el bloqueo de la app activado, las que muestra la app dicen aún menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications push disent seulement ce qui s’est passé, jamais le contenu de vos discussions. Avec le verrouillage de l’app, celles qu’elle affiche en disent encore moins."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プッシュ通知には起きたことだけを表示し、チャットの内容は含みません。アプリロックがオンの場合、アプリが表示する通知の情報はさらに少なくなります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações push dizem apenas o que aconteceu, nunca o que seus chats dizem. Com o bloqueio do app ativado, as que o app mostra dizem ainda menos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送通知只说明发生了什么，绝不包含聊天内容。开启 App 锁后，App 显示的通知内容也会更少。"
          }
        }
      }
    },
    "Queue": {
      "localizations": {
        "de": {
