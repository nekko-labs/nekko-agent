    "Saving asks for Face ID or your passcode and shows in this phone’s activity on the computer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Speichern erfordert Face ID oder deinen Code und erscheint in der Aktivität dieses Telefons auf dem Computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar pide Face ID o tu código y aparece en la actividad de este teléfono en la computadora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement demande Face ID ou votre code et apparaît dans l’activité de ce téléphone sur l’ordinateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存には Face ID またはパスコードが必要で、コンピュータ上のこの iPhone のアクティビティに表示されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar pede Face ID ou seu código e aparece na atividade deste celular no computador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储时需要 Face ID 或密码，并会显示在电脑上这部手机的活动记录中。"
          }
        }
