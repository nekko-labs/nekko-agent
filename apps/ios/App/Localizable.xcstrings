    "Asks for Face ID or your passcode. GitHub’s own rules (reviews, required checks) still apply.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt nach Face ID oder deinem Code. Die eigenen Regeln von GitHub (Reviews, erforderliche Prüfungen) gelten weiterhin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide Face ID o tu código. Las reglas propias de GitHub (revisiones, verificaciones obligatorias) siguen aplicando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande Face ID ou votre code. Les règles propres à GitHub (revues, vérifications requises) s’appliquent toujours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID またはパスコードを求めます。GitHub 独自のルール（レビュー、必須チェック）も引き続き適用されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede Face ID ou seu código. As regras do próprio GitHub (revisões, verificações obrigatórias) continuam valendo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 Face ID 或密码。GitHub 自身的规则（审查、必需检查）仍然适用。"
          }
        }
      }
    },
    "Asks on every open and every return, covers the app switcher preview, and keeps notifications and the Lock Screen free of chat details.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt bei jedem Öffnen und jeder Rückkehr, verdeckt die Vorschau im App-Umschalter und hält Mitteilungen und den Sperrbildschirm frei von Chat-Details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pide en cada apertura y cada regreso, oculta la vista previa del selector de apps y mantiene las notificaciones y la pantalla de bloqueo sin detalles de los chats."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande à chaque ouverture et à chaque retour, masque l’aperçu dans le sélecteur d’apps et garde les notifications et l’écran verrouillé sans détails des discussions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開くたび、戻るたびに認証を求め、App スイッチャーのプレビューを隠し、通知やロック画面にチャットの内容を表示しません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede a cada abertura e a cada retorno, cobre a prévia no seletor de apps e mantém notificações e a Tela de Bloqueio sem detalhes das conversas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次打开和返回时都会询问，遮盖 App 切换器预览，并让通知和锁定屏幕不显示聊天详情。"
          }
        }
      }
    },
