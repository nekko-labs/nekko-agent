    "Keep your chats on every device, end-to-end encrypted. Nekko Labs can't read them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte deine Chats auf jedem Gerät, Ende-zu-Ende-verschlüsselt. Nekko Labs kann sie nicht lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tus chats en todos tus dispositivos, cifrados de extremo a extremo. Nekko Labs no puede leerlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez vos discussions sur tous vos appareils, chiffrées de bout en bout. Nekko Labs ne peut pas les lire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットをすべてのデバイスでエンドツーエンド暗号化したまま保持します。Nekko Labs は内容を読めません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
