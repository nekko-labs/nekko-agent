    "Looks up, connects to and says hello on each of the computer's relay addresses.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlägt jede Relay-Adresse des Computers nach, verbindet sich und sendet ein Hallo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca, se conecta y saluda en cada una de las direcciones de relay de la computadora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résout, connecte et salue chacune des adresses de relais de l’ordinateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータの各 Relay アドレスを検索し、接続して、あいさつを送ります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve, conecta e envia uma saudação em cada endereço de relay do computador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对电脑的每个 Relay 地址进行查询、连接并发送问候。"
