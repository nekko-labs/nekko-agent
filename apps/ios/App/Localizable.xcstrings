    "%@ didn’t send its Model Server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat seinen Model Server nicht gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no envió su Model Server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas envoyé son Model Server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から Model Server の情報が届きませんでした。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não enviou seu Model Server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未发送其 Model Server 信息。"
          }
        }
      }
    },
    "%@ is %@. Start now and the chat begins when it’s back; it waits on this iPhone until then.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist %@. Jetzt starten, und der Chat beginnt, sobald der Computer wieder da ist; bis dahin wartet er auf diesem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is %2$@. Start now and the chat begins when it’s back; it waits on this iPhone until then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está %@. Inicia ahora y el chat comenzará cuando vuelva; mientras tanto espera en este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est %@. Démarrez maintenant : la discussion commence à son retour et attend sur cet iPhone d’ici là."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は%@です。今すぐ開始すると、復帰した時点でチャットが始まります。それまではこの iPhone で待機します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está %@. Inicie agora e a conversa começa quando voltar; ela espera neste iPhone até lá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 当前为%@。现在开始的话，聊天会在它恢复后启动，在此之前会先保存在这台 iPhone 上。"
          }
        }
      }
    },
