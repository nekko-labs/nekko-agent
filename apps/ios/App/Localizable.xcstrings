    "Runs ssh on %@ with its own keys and config; nothing about the keys reaches this phone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt ssh auf %@ mit eigenen Schlüsseln und eigener Konfiguration aus; nichts von den Schlüsseln erreicht dieses Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta ssh en %@ con sus propias llaves y configuración; nada de las llaves llega a este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute ssh sur %@ avec ses propres clés et sa propre configuration ; rien des clés n’arrive sur ce téléphone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で独自のキーと設定を使って ssh を実行します。キーの情報がこの iPhone に届くことはありません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa ssh em %@ com as próprias chaves e configuração; nada sobre as chaves chega a este celular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 上使用它自己的密钥和配置运行 ssh；密钥的任何内容都不会到达这部手机。"
          }
        }
      }
    },
