    "Hold the microphone while you speak and let go to stop. With VoiceOver, double-tap starts and double-tap again stops.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte das Mikrofon beim Sprechen gedrückt und lass zum Beenden los. Mit VoiceOver startet ein Doppeltippen und ein weiteres Doppeltippen beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionado el micrófono mientras hablas y suéltalo para detener. Con VoiceOver, toca dos veces para iniciar y toca dos veces de nuevo para detener."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le micro enfoncé pendant que vous parlez et relâchez pour arrêter. Avec VoiceOver, un double toucher démarre et un autre double toucher arrête."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話している間マイクを押し続け、離すと停止します。VoiceOver ではダブルタップで開始、もう一度ダブルタップで停止します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure o microfone enquanto fala e solte para parar. Com o VoiceOver, toque duas vezes para iniciar e toque duas vezes de novo para parar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话时按住麦克风，松开即停止。使用旁白时，轻点两下开始，再轻点两下停止。"
          }
        }
      }
    },
    "Hold to talk": {
      "localizations": {
        "de": {
          "stringUnit": {
