    "Use a wss:// relay instead: the Nekko relay or one you host. The relay only ever sees encrypted frames.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende stattdessen ein wss://-Relay: das Nekko-Relay oder ein eigenes. Das Relay sieht nur verschlüsselte Frames."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa mejor un relay wss://: el relay de Nekko o uno que tú alojes. El relay solo ve tramas cifradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez plutôt un relais wss:// : le relais Nekko ou le vôtre. Le relais ne voit jamais que des trames chiffrées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代わりに wss:// の Relay を使います。Nekko の Relay か、自分でホストしたものです。Relay には暗号化されたフレームしか見えません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um relay wss:// no lugar: o relay da Nekko ou um que você hospede. O relay só vê quadros criptografados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请改用 wss:// Relay：Nekko 的 Relay 或你自己托管的。Relay 只能看到加密的数据帧。"
          }
        }
      }
    },
