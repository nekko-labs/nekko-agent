    "Signing out keeps the synced chats on this iPhone until you forget everything in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Abmelden bleiben die synchronisierten Chats auf diesem iPhone, bis du in den Einstellungen alles entfernst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cerrar sesión, los chats sincronizados permanecen en este iPhone hasta que olvides todo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se déconnecter garde les discussions synchronisées sur cet iPhone jusqu’à ce que vous tout oubliiez dans Paramètres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトしても、設定ですべてを削除するまで、同期したチャットはこの iPhone に残ります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair mantém os chats sincronizados neste iPhone até você esquecer tudo em Configurações."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录后，已同步的聊天会保留在这台 iPhone 上，直到你在“设置”中忘记所有内容。"
          }
        }
      }
    },
