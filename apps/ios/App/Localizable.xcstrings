    "Your chats are encrypted on your devices before they're uploaded. Signing in only tells Nekko Cloud who you are.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Chats werden auf deinen Geräten verschlüsselt, bevor sie hochgeladen werden. Die Anmeldung teilt Nekko Cloud nur mit, wer du bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus chats se cifran en tus dispositivos antes de subirse. Iniciar sesión solo le dice a Nekko Cloud quién eres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos discussions sont chiffrées sur vos appareils avant d’être envoyées. Se connecter indique seulement à Nekko Cloud qui vous êtes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットはアップロード前にデバイス上で暗号化されます。サインインで Nekko Cloud に伝わるのは、あなたが誰かということだけです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus chats são criptografados nos seus dispositivos antes de serem enviados. Entrar só informa ao Nekko Cloud quem você é."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的聊天在上传前会先在你的设备上加密。登录只会让 Nekko Cloud 知道你是谁。"
          }
        }
      }
    },
