    "Only pair with a computer you own. It will be able to send this iPhone its chats, and this iPhone will be able to run tools on it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppele nur mit einem Computer, der dir gehört. Er kann diesem iPhone seine Chats senden, und dieses iPhone kann darauf Tools ausführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincula solo una computadora que sea tuya. Podrá enviar sus chats a este iPhone, y este iPhone podrá ejecutar herramientas en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez-vous uniquement à un ordinateur qui vous appartient. Il pourra envoyer ses discussions à cet iPhone, et cet iPhone pourra y exécuter des outils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のコンピュータとだけペアリングしてください。コンピュータはこの iPhone にチャットを送れるようになり、この iPhone はコンピュータ上でツールを実行できるようになります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só pareie com um computador seu. Ele poderá enviar seus chats a este iPhone, e este iPhone poderá executar ferramentas nele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只与你自己的电脑配对。它将能向这台 iPhone 发送其聊天内容，这台 iPhone 也将能在它上面运行工具。"
          }
        }
      }
    },
    "Only the first %@ of %@ is shown. Open it on the computer for the rest.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die ersten %@ von %@ werden angezeigt. Öffne es auf dem Computer für den Rest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Only the first %1$@ of %2$@ is shown. Open it on the computer for the rest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestran los primeros %@ de %@. Ábrelo en la computadora para ver el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les %@ premiers sur %@ sont affichés. Ouvrez-le sur l’ordinateur pour voir la suite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のうち最初の %@ のみ表示しています。残りはコンピュータで開いてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas os primeiros %@ de %@ são mostrados. Abra no computador para ver o resto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示前 %@（共 %@）。其余内容请在电脑上打开查看。"
          }
        }
      }
    },
