    "What can we figure out together?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was finden wir gemeinsam heraus?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué podemos resolver juntos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que pouvons-nous résoudre ensemble ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一緒に何を解き明かしましょうか?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que podemos descobrir juntos?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们可以一起弄清楚什么?"
          }
        }
      }
    },
    "What can we make simpler?": {
      "localizations": {
        "de": {
          "stringUnit": {
