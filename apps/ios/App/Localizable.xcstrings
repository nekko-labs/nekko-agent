    "Following %@’s effort setting. Higher effort thinks longer and spends more tokens.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgt der Aufwandseinstellung von %@. Mehr Aufwand denkt länger nach und verbraucht mehr Tokens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue el ajuste de esfuerzo de %@. Más esfuerzo piensa más tiempo y gasta más tokens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit le réglage d’effort de %@. Plus d’effort réfléchit plus longtemps et consomme plus de jetons."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の労力設定に従います。労力を上げると長く考え、より多くのトークンを使います。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue a configuração de esforço de %@. Mais esforço pensa por mais tempo e gasta mais tokens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿用 %@ 的投入程度设置。投入越高，思考越久，消耗的 token 越多。"
          }
        }
      }
    },
