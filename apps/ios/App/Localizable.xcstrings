    "In Nekko Agent on the computer: Settings → Remote access → Relay on this computer → Start relay, then Use this relay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Nekko Agent auf dem Computer: Einstellungen → Fernzugriff → Relay auf diesem Computer → Relay starten, dann „Dieses Relay verwenden“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Nekko Agent en la computadora: Ajustes → Acceso remoto → Relay en esta computadora → Iniciar relay, y luego Usar este relay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Nekko Agent sur l’ordinateur : Paramètres → Accès à distance → Relay sur cet ordinateur → Démarrer le relais, puis Utiliser ce relais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータの Nekko Agent で: 設定 → リモートアクセス → このコンピュータの Relay → Relay を開始、続けて この Relay を使う を選びます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No Nekko Agent do computador: Configurações → Acesso remoto → Relay neste computador → Iniciar relay e depois Usar este relay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑上的 Nekko Agent 中：设置 → 远程访问 → 此电脑上的 Relay → 启动 Relay，然后选择“使用此 Relay”。"
          }
        }
      }
    },
