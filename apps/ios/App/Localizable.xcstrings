    },
    "What happened, or what would you like it to do?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist passiert, oder was soll die App können?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué pasó, o qué te gustaría que hiciera?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que s’est-il passé, ou que voudriez-vous qu’elle fasse ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何が起きましたか？またはどんな機能が欲しいですか？"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que aconteceu, ou o que você gostaria que ele fizesse?"
