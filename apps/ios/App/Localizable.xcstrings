    "Unloading frees the model’s memory on %@. The next reply that uses it loads it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entladen gibt den Speicher des Modells auf %@ frei. Die nächste Antwort, die es nutzt, lädt es wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargar libera la memoria del modelo en %@. La próxima respuesta que lo use lo vuelve a cargar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décharger libère la mémoire du modèle sur %@. La prochaine réponse qui l’utilise le recharge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アンロードすると %@ のモデルのメモリが解放されます。次にそのモデルを使う返信で再び読み込まれます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarregar libera a memória do modelo em %@. A próxima resposta que o usar o carrega de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载会释放 %@ 上该模型占用的内存。下次使用它的回复会重新加载。"
          }
        }
      }
    },
