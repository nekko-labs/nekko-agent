    "Messages are end-to-end encrypted on every route; the relay sees only sealed frames.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten sind auf jeder Route Ende-zu-Ende-verschlüsselt; das Relay sieht nur versiegelte Frames."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes están cifrados de extremo a extremo en todas las rutas; el relay solo ve tramas selladas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages sont chiffrés de bout en bout sur chaque route ; le relais ne voit que des trames scellées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージはどの経路でもエンドツーエンドで暗号化され、Relay には封印されたフレームしか見えません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens são criptografadas de ponta a ponta em todas as rotas; o relay vê apenas quadros selados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息在每条线路上都经过端到端加密；Relay 只能看到密封的数据帧。"
          }
        }
      }
    },
