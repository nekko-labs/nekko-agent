    "How hard the model works on each reply. Higher takes longer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie intensiv das Modell an jeder Antwort arbeitet. Höher dauert länger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto se esfuerza el modelo en cada respuesta. Más alto tarda más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’effort du modèle pour chaque réponse. Plus il est élevé, plus c’est long."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各返信でモデルがどれだけ深く考えるかです。高いほど時間がかかります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto esforço o modelo dedica a cada resposta. Mais alto demora mais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
