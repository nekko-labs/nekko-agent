          }
        }
      }
    },
    "Type the code %@ shows. Only approve it if it's yours: it will be able to read everything you sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den Code ein, den %@ anzeigt. Gib es nur frei, wenn es dir gehört: Es kann alles lesen, was du synchronisierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe el código que muestra %@. Apruébalo solo si es tuyo: podrá leer todo lo que sincronices."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code affiché par %@. N’approuvez que s’il est à vous : il pourra lire tout ce que vous synchronisez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に表示されるコードを入力してください。自分のデバイスの場合のみ承認してください。同期するすべての内容を読み取れるようになります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o código que %@ mostra. Só aprove se for seu: ele poderá ler tudo o que você sincroniza."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 %@ 显示的代码。仅当它是你自己的设备时才批准：它将能读取你同步的所有内容。"
          }
        }
      }
    },
