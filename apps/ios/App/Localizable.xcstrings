    "Turn Remote access on and choose Pair a phone to show the pairing code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte den Fernzugriff ein und wähle „Telefon koppeln“, um den Kopplungscode anzuzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Acceso remoto y elige Vincular un teléfono para mostrar el código de vinculación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’accès à distance et choisissez Associer un téléphone pour afficher le code d’association."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートアクセスをオンにして iPhone をペアリング を選ぶと、ペアリングコードが表示されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Acesso remoto e escolha Parear um celular para mostrar o código de pareamento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启远程访问并选择“配对手机”以显示配对码。"
          }
        }
      }
    },
    "Turn it on on %@ in Remote access → What phones can do.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte es auf %@ unter Fernzugriff → Was Telefone dürfen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
