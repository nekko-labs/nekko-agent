    "Local network access is off for Nekko Agent. Turn it on in Settings → Privacy & Security → Local Network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf das lokale Netzwerk ist für Nekko Agent ausgeschaltet. Schalte ihn unter Einstellungen → Datenschutz & Sicherheit → Lokales Netzwerk ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la red local está desactivado para Nekko Agent. Actívalo en Ajustes → Privacidad y seguridad → Red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au réseau local est désactivé pour Nekko Agent. Activez-le dans Réglages → Confidentialité et sécurité → Réseau local."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekko Agent のローカルネットワークへのアクセスがオフです。設定 → プライバシーとセキュリティ → ローカルネットワーク でオンにしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à rede local está desativado para o Nekko Agent. Ative em Configurações → Privacidade e Segurança → Rede Local."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekko Agent 的本地网络访问已关闭。请在“设置”→“隐私与安全性”→“本地网络”中开启。"
          }
        }
      }
    },
