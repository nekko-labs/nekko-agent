    "Git refuses if uncommitted changes would be lost.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Git lehnt ab, wenn nicht committete Änderungen verloren gingen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Git lo rechaza si se perderían cambios sin confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git refuse si des modifications non commitées seraient perdues."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未コミットの変更が失われる場合、Git は実行を拒否します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Git recusa se alterações sem commit fossem perdidas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果会丢失未提交的更改，Git 会拒绝执行。"
