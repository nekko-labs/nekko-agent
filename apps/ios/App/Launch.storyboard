<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch-controller">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies><plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22504"/><capability name="Safe area layout guides" minToolsVersion="9.0"/></dependencies>
    <scenes><scene sceneID="launch-scene"><objects>
        <viewController id="launch-controller" sceneMemberID="viewController"><view key="view" contentMode="scaleToFill" id="launch-view"><rect key="frame" x="0.0" y="0.0" width="393" height="852"/><subviews>
            <!-- The opening animation's first frame (SplashView.draw): the cat twice `side` = max(40, longer side × 0.085) wide, centred. -->
            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchCat" translatesAutoresizingMaskIntoConstraints="NO" id="launch-cat"><rect key="frame" x="124" y="354" width="145" height="145"/></imageView>
        </subviews>
        <constraints>
            <constraint firstItem="launch-cat" firstAttribute="centerX" secondItem="launch-view" secondAttribute="centerX" id="launch-cx"/>
            <constraint firstItem="launch-cat" firstAttribute="centerY" secondItem="launch-view" secondAttribute="centerY" id="launch-cy"/>
            <constraint firstItem="launch-cat" firstAttribute="height" secondItem="launch-cat" secondAttribute="width" id="launch-square"/>
            <constraint firstItem="launch-cat" firstAttribute="width" relation="greaterThanOrEqual" constant="80" id="launch-min"/>
            <constraint firstItem="launch-cat" firstAttribute="width" relation="greaterThanOrEqual" secondItem="launch-view" secondAttribute="width" multiplier="0.17" id="launch-w"/>
            <constraint firstItem="launch-cat" firstAttribute="width" relation="greaterThanOrEqual" secondItem="launch-view" secondAttribute="height" multiplier="0.17" id="launch-h"/>
            <constraint firstItem="launch-cat" firstAttribute="width" constant="0" priority="250" id="launch-least"/>
        </constraints>
        <viewLayoutGuide key="safeArea" id="launch-safe"/><color key="backgroundColor" red="0.615686" green="0.549020" blue="0.901961" alpha="1" colorSpace="custom" customColorSpace="sRGB"/></view></viewController>
        <placeholder placeholderIdentifier="IBFirstResponder" id="launch-responder" sceneMemberID="firstResponder"/>
    </objects></scene></scenes>
    <resources><image name="LaunchCat" width="40" height="40"/></resources>
</document>
